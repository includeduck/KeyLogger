<Window x:Class="KeyMapper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KeyMapper Desktop"
        Height="420"
        Width="640"
        MinHeight="360"
        MinWidth="520"
        Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="KeyMapper Desktop"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#1F2937" />
            <TextBlock Text="Phase 0 shell"
                       Margin="0,6,0,0"
                       Foreground="#64748B"
                       FontSize="14" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,28"
                Padding="24"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Collector status"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#111827" />

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Margin="0,14,0,0"
                           Text="Idle - keyboard collection starts in Phase 2"
                           FontSize="15"
                           Foreground="#475569" />

                <StackPanel Grid.Row="2"
                            Margin="0,24,0,0"
                            Orientation="Horizontal">
                    <Border Padding="14,10"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#F8FAFC">
                        <StackPanel>
                            <TextBlock Text="Pending events"
                                       Foreground="#64748B"
                                       FontSize="12" />
                            <TextBlock Text="0"
                                       Margin="0,4,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#0F766E" />
                        </StackPanel>
                    </Border>

                    <Border Margin="12,0,0,0"
                            Padding="14,10"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#F8FAFC">
                        <StackPanel>
                            <TextBlock Text="Last sync"
                                       Foreground="#64748B"
                                       FontSize="12" />
                            <TextBlock Text="Never"
                                       Margin="0,4,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#B45309" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Close minimizes to the notification area."
                   Foreground="#64748B"
                   FontSize="12" />
    </Grid>
</Window>
